/go.work
/go.work.sum

# IDE/editor specific files
.vscode/
.idea/
*.swp

# Logs and debug
*.log
*.trace

# OS generated files
.DS_Store
Thumbs.db

# Go coverage output
coverage.*
*.coverprofile

# Temporary files
*.tmp
*.bak
*.old
*.html

# Env files
.env
.env.*
